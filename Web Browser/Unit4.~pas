function TForm4.Captura(s: string): string;
var
  start, stop: byte; s2: string;
begin
while (Pos('[b]SECTION 1',s) <> 0)  do
  begin
    start:= Pos('SECTION 1', s);
    stop:= Pos('Todos os preços são sugeridos para varejo.', s);
    S2:=S2+''+Copy(s, start, stop - start);
    Result:= Uppercase(s2);
  end;
end;


