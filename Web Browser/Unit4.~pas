procedure TForm4.Button8Click(Sender: TObject);
var
i:integer;
s,sub,susu: string;
begin
Memo5.Clear;
  for i:= 0 to Memo2.Lines.Count -1 do
  begin

      if (copy(Memo2.Lines[i],1,9) <> 'SECTION 1')
     and (copy(Memo2.Lines[i],1,9) <> 'SECTION 2')
