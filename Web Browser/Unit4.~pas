     begin

     //Aqui são os nomes das coleções
     if StrIsInteger(copy(Memo2.Lines[i],1,1)) = False then
     begin
     s:=Memo2.Lines[i];
         if StrIsInteger(copy(Memo2.Lines[i+1],1,1)) = False then
