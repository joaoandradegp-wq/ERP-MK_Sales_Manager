procedure TForm2.db_linhaEnter(Sender: TObject);
var
i,y:integer;
begin
db_linha.Color:=clWindow;

db_linha.Items.Clear;
db_linha.ItemIndex:=0;

ADOQuery3.Open;
y:=ADOQuery3.RecordCount;
i:=0;
while i < y do
begin
i:=i+1;
db_linha.Items.Add(ADOQuery3.Fieldbyname('linha').Value);
ADOQuery3.Next;
end;
ADOQuery3.Close;
end;

